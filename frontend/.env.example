# Copy to .env.local and fill in. Both values come from the shared Supabase
# project — Settings > API. Ask Praneet if you do not have them.
#
# Vite only exposes variables prefixed VITE_, and it exposes them to the
# browser. The service_role key is NOT one of these and must never appear in
# this directory. See docs/AUTH.md section 5.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
